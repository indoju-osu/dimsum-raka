# PostgreSQL connection string for Google Cloud Run / Cloud SQL / Neon / Supabase
# Jika dikosongkan pada mode pengembangan lokal, server otomatis menggunakan penyimpanan lokal fallback.
DATABASE_URL="postgresql://user:password@localhost:5432/dapur_dimsum"

# Rahasia penandatanganan JWT untuk sesi Admin Dashboard (wajib diganti pada production)
JWT_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# Port server Express (default 3000)
PORT=3000

# APP_URL: URL tempat aplikasi di-hosting
APP_URL="http://localhost:3000"
